<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>o8 uses your microphone for push-to-talk voice dictation.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>o8 uses Apple Speech Recognition to turn your voice into text before polish runs.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>o8 uses Accessibility to capture the global Fn hotkey and paste dictated text into the app you are working in.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>o8 uses Automation to restore focus after a voice action completes.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Symon reads your calendar to answer "what's on my calendar" by voice.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Symon reads your reminders to answer "what's on my list" by voice.</string>
    <!-- App Transport Security: the embedded native browser-view (a host-owned
         child WebviewWindow) loads arbitrary HTTPS sites (Clerk auth apps, etc.).
         Its in-page agent must POST grab/read/click results back to the local o8
         server at http://127.0.0.1:<port>/api/browser/native-result. ATS blocks
         HTTP requests made from an HTTPS page by default ("TypeError: Load failed"),
         which kills the result channel on every real (HTTPS) site. Scope the
         exception to web-content + local networking so ATS stays in force for the
         rest of the app's network calls. (127.0.0.1/localhost are already exempt
         from the web-platform mixed-content algorithm; this lifts only the ATS
         network-layer block.) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- Every entry is rank Alternate: o8 is offered under Open With and can be
         chosen as the default in Get Info, but installing it never takes a
         file type away from the app that already opens it. Markdown and the
         common text and source types are named explicitly because Finder does
         not reliably offer an app through the catch-all alone. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Text and source documents</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
                <string>public.text</string>
                <string>public.plain-text</string>
                <string>public.source-code</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>md</string><string>markdown</string><string>mdx</string>
                <string>txt</string><string>rs</string><string>ts</string>
                <string>tsx</string><string>js</string><string>jsx</string>
                <string>py</string><string>c</string><string>h</string>
                <string>cpp</string><string>go</string><string>swift</string>
                <string>sh</string><string>json</string><string>yaml</string>
                <string>yml</string><string>toml</string><string>xml</string>
                <string>html</string><string>css</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Any document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.data</string>
                <string>public.text</string>
                <string>public.source-code</string>
                <string>public.plain-text</string>
                <!-- Explicit UTIs: LaunchServices does NOT reliably surface
                     Open With entries via public.data conformance alone —
                     PNG/HTML were missing from the menu (operator 2026-07-09)
                     despite the catch-all above. Images render via the file
                     card / ImagePreview; HTML via HtmlPreview. -->
                <string>public.image</string>
                <string>public.html</string>
                <string>public.xml</string>
                <string>public.json</string>
                <string>public.yaml</string>
                <string>com.netscape.javascript-source</string>
            </array>
        </dict>
    </array>
    <!-- Custom URL scheme o8:// for the Clerk auth deep-link handoff
         (o8://auth/callback?ticket=...&state=...). macOS LaunchServices routes
         it to the running app → RunEvent::Opened in lib.rs. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>ai.o8.desktop.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>o8</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
