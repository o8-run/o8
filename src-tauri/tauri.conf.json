{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "o8",
  "version": "0.1.815",
  "identifier": "ai.o8.desktop",
  "build": {
    "frontendDist": "../out/frontend",
    "devUrl": "http://localhost:3001/dashboard",
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "npm run tauri:prebuild"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "o8",
        "width": 1600,
        "height": 1024,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 25
        },
        "decorations": true,
        "transparent": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* wss://speech.platform.bing.com; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; frame-src http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../out/server": "server/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "Developer ID Application: Marquise Hurtt (3U3MXN796S)",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.o8.run/v1/update/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/hurttlocker/o8-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2NTIxQTI4MjkyODVGQTcKUldTblh5Z3BLQnBTaHI4VWFFM1VMVG1ZTU0wOExQQmRiYlZyZUJ3UExSUWVyRFpvcFNKQkZ4Uy8K"
    }
  }
}
