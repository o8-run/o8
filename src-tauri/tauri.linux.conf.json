{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "o8",
        "width": 1600,
        "height": 1024,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["o8"]
      }
    }
  },
  "bundle": {
    "linux": {
      "deb": {
        "desktopTemplate": "linux/o8.desktop",
        "recommends": ["nodejs (>= 22)"]
      },
      "rpm": {
        "desktopTemplate": "linux/o8.desktop",
        "recommends": ["nodejs >= 22.0.0"]
      }
    }
  }
}
