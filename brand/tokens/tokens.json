{
  "$schema-note": "o8 Branding v1 tokens. Plain values; copy them, don't link to this file at runtime.",
  "version": "v1 (2026-11-12)",
  "color": {
    "paper":        { "hex": "#F4F2EC", "use": "Default background everywhere. Never pure white." },
    "paper-deep":   { "hex": "#EEEBE2", "use": "Nested surfaces, sidebars, code blocks on paper" },
    "card":         { "hex": "#FDFCFA", "use": "Raised cards and windows" },
    "hairline":     { "hex": "#CFCAC0", "use": "1px borders on paper (or ink at 9% alpha)" },
    "ink":          { "hex": "#17140F", "use": "Text and the marks. Never pure black." },
    "ink-muted":    { "hex": "#5C584F", "use": "Secondary text" },
    "ink-faint":    { "hex": "#706C64", "use": "Labels, meta" },
    "graphite":     { "hex": "#242424", "use": "Dark brand surface: dark app icon tile, dark marketing" },
    "graphite-eye": { "hex": "#1C1A17", "use": "Glance's eyes on a light (dark-mode) body" },
    "orange":       { "hex": "#FF5A1F", "use": "The one accent: the review point, a status dot, one highlight per screen" },
    "orange-ink":   { "hex": "#B73A0B", "use": "Orange for small text on paper (contrast)" },
    "link":         { "hex": "#2563EB", "use": "Links, focus rings, selection in the app. One blue only." },
    "success":      { "hex": "#16A34A", "use": "Status only" },
    "danger":       { "hex": "#EF4444", "use": "Status only" }
  },
  "glance-state": {
    "reviewing": { "body": "#17140F", "eye": "#F4F2EC", "pupil": "#17140F", "dot": "#FF5A1F" },
    "working":   { "body": "#17140F", "eye": "#F4F2EC", "pupil": "#17140F", "dot": "#A8A398" },
    "sent-back": { "body": "#FF5A1F", "eye": "#F4F2EC", "pupil": "#17140F", "dot": "#17140F" },
    "approved":  { "body": "#15803D", "eye": "#F4F2EC", "pupil": "#17140F", "dot": "#F4F2EC" },
    "dark-mode": { "reviewing/working body": "#F4F2EC", "eye": "#1C1A17", "pupil": "#F4F2EC", "note": "sent-back and approved keep their light colours" }
  },
  "type": {
    "sans": "Inter Tight", "mono": "JetBrains Mono",
    "display": { "weight": 300, "tracking": "-0.02em" },
    "body": { "weight": 400, "site_px": "15-17", "app_px": "13-14" },
    "emphasis": { "weight": 500, "note": "Nothing heavier. No bold." },
    "wordmark": { "text": "o8", "weight": 500, "tracking": "-0.045em", "case": "always lowercase" },
    "mono": { "weight": 400, "use": "hashes, commit ids, timestamps, receipts, code. Never body copy." }
  },
  "radius": { "control": 8, "card": 12, "window": 16, "max": 16 },
  "shadow": { "window": "0 30px 80px rgba(40,30,20,0.16)", "everything-else": "1px hairline, no shadow" },
  "motion": {
    "ui_ms": "150-250", "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "indicator_crossfade_ms": 300, "indicator_switch": "at the end of the current loop",
    "reduced_motion": "hold the first frame, keep the status line"
  },
  "ring": { "viewBox": "0 0 100 100", "outer_r": 40, "inner_r": 22, "point_angle_deg": -45, "point_r": 7.4, "point_gap": 3.4, "loop_step_deg": 60 },
  "glance-size": { "fog": ">= 48px", "tight": "24-40px (small cut)", "hairline": "16-20px (small cut)", "minimum": "16px" }
}
