.DS_Store
node_modules
node_modules/
dist/
build/
.next/
.o8-generated-output-store
.o8-retired-generated-*
.o8-retained-legacy-*
.o8-retained-prebuild-*
next-env.d.ts
.env
.env.*
# But DO track the example — devs need it as a reference on clone.
!.env.example
# Release-time build config (device-flow client id, etc.) — deployment-specific,
# baked into signed builds by scripts/tauri-export.mjs. Track only the template.
o8.release.json
coverage/
*.log
*.tsbuildinfo
*.png
# ...but launch/brand assets are committed on purpose (README hero, icons)
!assets/**/*.png
!docs/**/*.png
!.github/**/*.png
!plugins/o8/assets/o8-icon.png
artifacts/research/
.playwright-mcp/

# Worktree isolation
.cortex-worktrees/
.claude/worktrees/

# Agent attempt learnings + orchestrator scratch state — repo-local cache
# the supervisor writes during retry cycles. Not source.
.o8/

# Smoke test artifacts
test-results/
tests/bench/latest/
tmp/
smoke-*.txt
mobile-*.txt
p1-*.txt
playwright-workspace-snapshot.md

# Build & deploy
src-tauri/target/
.vercel
out/

# Voice STT sidecar — compiled binaries (build.rs regenerates from .swift).
# The Swift source + Info.plist ARE tracked; the per-arch/universal/fat
# Mach-O artifacts are not.
src-tauri/helpers/speech_recognizer
src-tauri/helpers/speech_recognizer-*

# Design artifacts
mockups/
assets/mockups/
branding/

# o8 transient review/merge report scratch files (#1491/#1492). Written to a
# repo/worktree root during generation and unlinked after read; ignored so a
# crash mid-generation can't leave one committable by a later `git add -A`.
.o8-packet-explainer*.html
.o8-buyin-doc*.html

# Local settings
.claude/settings.local.json
.claude/settings.json
.claude/scheduled_tasks.lock
src-tauri/helpers/speech-local
src-tauri/helpers/speech-local-*
src-tauri/helpers/o8-pi-write
src-tauri/helpers/o8-pi-write-*
src-tauri/sidecars/speech-local/.build/
src-tauri/sidecars/pi-write/target/

# Local scratch output (release cards, one-off renders) — never repo content
scratch/
.tmp-owned-push-*/
*.local.md

# Generated QA-eval result dumps (contain internal project data — never commit)
tests/qa-eval/three-way-results-*.json

# Private services live in their own repos (o8-license-server, o8-relay).
# Local working copies may remain on a maintainer machine — never re-add them.
services/

# Private knowledge the Engineering Brain ingests locally but the public repo never sees.
# spec-ingest walks the filesystem (not git), so these stay searchable by the Brain
# while remaining untracked. Do NOT remove this ignore or force-add these files.
docs/private/

src-tauri/helpers/o8-next
src-tauri/helpers/o8-next-*
